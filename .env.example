# Elasticsearch Configuration
# WARNING: Change this in production!
# Use a strong password: at least 12 characters with uppercase, lowercase, numbers, and special chars
ELASTIC_PASSWORD=your_secure_password_here
ELASTIC_USERNAME=elastic

# Heap memory sizes (if you need to customize)
# LOGSTASH_HEAP_SIZE=256m
# ELASTICSEARCH_HEAP_SIZE=512m

# Elasticsearch service settings
# ELASTICSEARCH_VERSION=8.19.17
# ES_JAVA_OPTS=-Xms512m -Xmx512m

# Kibana settings
# KIBANA_VERSION=8.19.17
# KIBANA_DEFAULTAPPID=discover

# Nginx worker settings (optional)
# NGINX_WORKER_PROCESSES=auto
# NGINX_WORKER_CONNECTIONS=1024
